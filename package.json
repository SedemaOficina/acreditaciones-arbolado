{
  "name": "acreditaciones-arbolado",
  "private": true,
  "description": "Sistema de Acreditaciones de Poda y Dictaminación (SEDEMA, para el SIA)",
  "type": "module",
  "scripts": {
    "esquema": "node herramientas/generar-esquema.mjs",
    "verificar-esquema": "node herramientas/generar-esquema.mjs --verificar",
    "probar-base": "bash herramientas/probar-base.sh",
    "probar-sitio": "node herramientas/probar-sitio.mjs http://localhost:8765/ verificacion/capturas",
    "construir-sitio": "node herramientas/construir-sitio.mjs",
    "probar-esquemas": "node herramientas/probar-esquemas.mjs",
    "pendientes": "node herramientas/generar-pendientes.mjs",
    "textos": "node herramientas/inventario-textos.mjs http://localhost:8765/ && python3 herramientas/inventario-textos.py",
    "probar-examen": "node herramientas/probar-examen.mjs http://localhost:8765/ verificacion/capturas"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "pdfjs-dist": "4.10.38",
    "playwright": "1.63.0"
  }
}
